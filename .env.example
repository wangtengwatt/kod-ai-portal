# ============================================================
# kod-ai-portal 部署环境变量
# 复制为 .env 后填写：cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交到仓库
# ============================================================

# ---- 必填 ----

# MySQL 数据库连接
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=kod
MYSQL_USERNAME=
MYSQL_PASSWORD=

# Redis 缓存连接
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT 签名密钥（生成方式：openssl rand -hex 32）
JWT_SECRET=

# ---- 选填（邮件验证码，不配则验证码仅打印日志）----

# SMTP 邮件服务器（默认 Zoho）
MAIL_HOST=smtp.zoho.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
