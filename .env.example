# ============================================================
# kod-ai-portal 部署环境变量
# 复制为 .env 后填写：cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交到仓库
# ============================================================

# ---- 必填 ----

# MySQL 数据库连接
MYSQL_HOST=mysql.example.internal
MYSQL_PORT=3306
MYSQL_DATABASE=kod
MYSQL_USERNAME=kod
MYSQL_PASSWORD=replace-with-a-secret-from-your-secret-manager

# Redis 缓存连接
REDIS_HOST=redis.example.internal
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-secret-from-your-secret-manager

# JWT 签名密钥（生成方式：openssl rand -hex 32）
JWT_SECRET=replace-with-at-least-32-random-bytes

# ---- 必填（生产环境验证码必须通过 SMTP 发送，永不写入日志）----

# SMTP 邮件服务器
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- Cross-device sync and private media objects ----

# Exactly 32 random bytes, Base64 encoded. Existing production values must come from a KMS/secret manager.
KOD_SYNC_VAULT_MASTER_KEY=

# S3-compatible private bucket. The endpoint must be HTTPS in production; leave it empty when using AWS S3 defaults.
KOD_MEDIA_STORAGE_ENABLED=true
KOD_MEDIA_STORAGE_ENDPOINT=https://s3.example.com
KOD_MEDIA_STORAGE_REGION=us-east-1
KOD_MEDIA_STORAGE_BUCKET=kod-private-media
KOD_MEDIA_STORAGE_ACCESS_KEY=
KOD_MEDIA_STORAGE_SECRET_KEY=
KOD_MEDIA_STORAGE_PATH_STYLE_ACCESS=false
KOD_MEDIA_STORAGE_SERVER_SIDE_ENCRYPTION=AES256
KOD_MEDIA_STORAGE_MAX_OBJECT_BYTES=134217728
KOD_MEDIA_STORAGE_MAX_USER_BYTES=5368709120

# Public iOS OIDC client registered with KAI Identity; never put a client secret in the app.
KOD_IDENTITY_IOS_CLIENT_ID=

# Cloud worker authentication. Generate at least 32 random bytes.
KOD_WORKER_BOOTSTRAP_SECRET=
KOD_WORKER_HEARTBEAT_TTL_MILLIS=60000
KOD_WORKER_RECOVERY_INTERVAL_MILLIS=30000

# ---- StoreKit 2 ----

KOD_STOREKIT_ENABLED=true
KOD_STOREKIT_BUNDLE_ID=com.kai.kod
KOD_STOREKIT_APP_APPLE_ID=
KOD_STOREKIT_ROOT_CERTIFICATE_PATHS=/run/secrets/apple/AppleRootCA-G3.cer
KOD_STOREKIT_SUBSCRIPTION_PRODUCT_IDS=com.kai.kod.pro.monthly
KOD_STOREKIT_CONSUMABLE_CREDITS=com.kai.kod.credits.100=100
KOD_APPLE_ROOT_CERTIFICATES_HOST=./secrets/apple

# ---- 可选（服务配置）----

# 后端服务端口
SERVER_PORT=8080

# JWT 过期时间（毫秒），默认 7 天
JWT_EXPIRE_MILLIS=604800000

# ---- KOD 算力中心 ----

# 逗号分隔的管理员邮箱白名单。管理员仍必须先注册为 KOD 用户。
KOD_COMPUTE_ADMIN_EMAILS=admin@example.com

# Token 套餐交付给外部工具使用的 OpenAI 兼容代理 Base URL。
KOD_COMPUTE_PROXY_BASE_URL=http://127.0.0.1:8080/api/compute/proxy/v1

# KAI 公司中转站域名。双方均属于这些域名时允许跨中转站转让卡时。
KOD_COMPUTE_KAI_STATION_DOMAINS=kai.com

# 公司标准：1 KAI 标准卡时 = 1.002 CNY
KOD_CARD_HOUR_CNY_RATE=1.002
KOD_TRANSFER_REVIEW_THRESHOLD_CARD_HOURS=1000.000

# 至少 32 位随机值，用于加密供应方填写的 SSH/Jupyter/API 等交付信息。
KOD_COMPUTE_DELIVERY_SECRET=replace-with-at-least-32-random-characters
KOD_COMPUTE_SCHEMA_INIT_ENABLED=false
KOD_COMPUTE_TEST_IDENTITY_ENABLED=false
KOD_COMPUTE_PRIVATE_STORAGE_DIRECTORY=./data/compute-private
KOD_COMPUTE_DEMO_SEED_ENABLED=false
KOD_COMPUTE_DEMO_SUPPLIER_EMAIL=
KOD_COMPUTE_DEMO_BUYER_EMAIL=

# Vast.ai 实时可租实例行情。请在 Vast.ai 撤销聊天中暴露过的旧密钥，只在本机或密钥管理器中填写新密钥。
VAST_API_KEY=
VAST_SEARCH_URL=https://console.vast.ai/api/v0/bundles/
AKAMAI_GPU_PRODUCT_URL=https://www.akamai.com/zh/products/gpu/nvidia
AKAMAI_GPU_TYPES_URL=https://api.linode.com/v4/linode/types?page_size=500
KOD_USD_CNY_RATE=7.2000
KOD_MARKET_PRICE_ENABLED=true
KOD_MARKET_PRICE_REFRESH_MILLIS=5000
KOD_MARKET_PRICE_HISTORY_SAMPLE_MILLIS=60000
KOD_MARKET_PRICE_HISTORY_RETENTION_DAYS=30

# ---- 游客官网蒜宝（固定服务端上游，默认关闭）----

ASSISTANT_ENABLED=false
ASSISTANT_BASE_URL=https://ai.example.com
ASSISTANT_API_KEY=
ASSISTANT_MODEL=

# 逗号分隔，必须包含 ASSISTANT_BASE_URL 的 host
ASSISTANT_ALLOWED_HOSTS=ai.example.com
ASSISTANT_CONNECT_TIMEOUT=10s
ASSISTANT_STREAM_TIMEOUT=45s
ASSISTANT_MAX_INPUT_CHARS=500
ASSISTANT_MAX_MESSAGE_CHARS=1000
ASSISTANT_MAX_MESSAGES=8
ASSISTANT_MAX_CONTEXT_CHARS=4000
ASSISTANT_MAX_PER_MINUTE_PER_IP=10
ASSISTANT_MAX_DAILY_PER_IP=80
ASSISTANT_MAX_DAILY_PER_DEVICE=50
ASSISTANT_MAX_CONCURRENT_PER_DEVICE=1
