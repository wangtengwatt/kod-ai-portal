# ---- 选填（邮件验证码，不配则验证码仅打印日志）----

# SMTP 邮件服务器
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- 可选（服务配置）----

# 后端服务端口
SERVER_PORT=8080

# JWT 过期时间（毫秒），默认 7 天
JWT_EXPIRE_MILLIS=604800000
