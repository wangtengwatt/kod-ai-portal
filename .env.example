# docker-compose 部署环境变量示例
# 复制为 .env 并按实际填写：cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，不会提交到仓库
#
# MySQL / Redis 使用外部已有实例（不由 compose 创建容器）。
# kod 库的建表 SQL：backend/src/main/resources/schema.sql

# 已有的 MySQL
MYSQL_HOST=18.139.134.29
MYSQL_PORT=3306
MYSQL_DATABASE=kod
MYSQL_USERNAME=aiex_dev
MYSQL_PASSWORD=change-me

# 已有的 Redis
REDIS_HOST=18.139.134.29
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# JWT 签名密钥（至少 32 字节）
JWT_SECRET=change-me-a-long-random-secret-at-least-32-bytes
