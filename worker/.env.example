KOD_API_BASE=https://kod.kai.com
KOD_WORKER_NAME=h100-worker-01
KOD_WORKER_TOKEN_FILE=/var/lib/kod-worker/token
KOD_SANDBOX_IMAGE=ubuntu:24.04
KOD_SANDBOX_MEMORY=8g
KOD_SANDBOX_CPUS=4
KOD_SANDBOX_PIDS=512
KOD_SANDBOX_NETWORK=none
# Opt in only on GPU-designated workers, for example: device=0
KOD_SANDBOX_GPUS=
KOD_WORKER_POLL_SECONDS=1
# Must stay below the backend heartbeat TTL (60 seconds by default).
KOD_WORKER_CONTROL_GRACE_SECONDS=45
